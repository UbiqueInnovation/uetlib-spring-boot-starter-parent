<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- NEEDS TO BE KEPT IN SYNC WITH spring-boot.version BELOW -->
        <version>4.1.0</version>
        <relativePath/>
    </parent>

    <groupId>ch.ubique</groupId>
    <artifactId>uetlib-spring-boot-starter-parent</artifactId>
    <packaging>pom</packaging>
    <version>2027.0.0-SNAPSHOT</version>
    <name>Uetlib-wrapped Spring Boot Starter Parent</name>

    <properties>
        <java.version>25</java.version>

        <kotlin.version>2.4.10</kotlin.version>

        <!-- NEEDS TO BE KEPT IN SYNC WITH spring-boot-starter-parent.version ABOVE -->
        <spring-boot.version>4.1.0</spring-boot.version>

        <!-- one of DEFAULT, OFF, WARN, ERROR-->
        <explicit-null-marking-level>ERROR</explicit-null-marking-level>
        <error-prone-excluded-paths>.*/src/test/java/.*</error-prone-excluded-paths>

        <!-- Sonar & Jacoco coverage reports -->
        <!-- Set sonar.coverage.module to the name of the module holding the aggregated jacoco report:
             the current module's own name for single-module projects (the default), or another
             module's name (e.g. a dedicated `{{project}}-coverage` module) for multi-module projects -->
        <sonar.coverage.module>${project.artifactId}</sonar.coverage.module>
        <!-- Path to the JaCoCo XML report. For a multi-module project with a dedicated
            coverage module, override sonar.coverage.module in the project parent.
            For a single-module project, leave the default (the current project's
            artifactId) so the report is expected at target/site/jacoco-aggregate/jacoco.xml. -->
        <sonar.coverage.jacoco.xmlReportPaths>
            ${maven.multiModuleProjectDirectory}/${sonar.coverage.module}/target/site/jacoco-aggregate/jacoco.xml
        </sonar.coverage.jacoco.xmlReportPaths>
        <sonar.projectName>${project.artifactId}</sonar.projectName>
        <sonar.projectKey>UbiqueInnovation_${sonar.projectName}</sonar.projectKey>
        <sonar.organization>ubiqueinnovation</sonar.organization>
        <sonar.host.url>https://sonarcloud.io</sonar.host.url>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.jspecify</groupId>
            <artifactId>jspecify</artifactId>
        </dependency>
    </dependencies>

    <dependencyManagement>
        <dependencies>
            <!--
                    Imported BOM precedence:
                    Maven uses the first managed version it encounters for overlapping entries
                    from imported BOMs. Therefore, keep the BOMs whose versions should be
                    authoritative first, and broader/foundation BOMs later.

                    Explicit dependencyManagement entries below this imported-BOM block are
                    intentional hard pins for individual artifacts.
            -->

            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-bom</artifactId>
                <version>2026.8.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>ch.ubique</groupId>
                <artifactId>uetlib-self-bom</artifactId>
                <version>5.3.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2025.1.2</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>ubique-artifactory</id>
            <name>backend</name>
            <url>https://artifactory.ubique.ch/artifactory/backend</url>
        </repository>
        <repository>
            <id>ubique-artifactory-virtual</id>
            <name>ubique</name>
            <url>https://artifactory.ubique.ch/artifactory/ubique</url>
        </repository>
        <repository>
            <id>osgeo</id>
            <name>Open Source Geospatial Foundation Repository</name>
            <url>https://repo.osgeo.org/repository/release/</url>
        </repository>
        <repository>
            <id>unidata-all</id>
            <name>Unidata All</name>
            <url>https://artifacts.unidata.ucar.edu/all</url>
        </repository>
    </repositories>

    <build>
        <!-- finalName to fix the name of the resulting jar -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>de.westemeyer</groupId>
                <artifactId>artifact-version-maven-plugin</artifactId>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
            </plugin>
        </plugins>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <!-- @formatter:off -->
                    <configuration>
                        <fork>true</fork>
                        <parameters>true</parameters>
                        <annotationProcessorPathsUseDepMgmt>
                            true
                        </annotationProcessorPathsUseDepMgmt>
                        <annotationProcessorPaths>
                            <path>
                                <groupId>com.google.errorprone</groupId>
                                <artifactId>error_prone_core</artifactId>
                            </path>
                            <path>
                                <groupId>com.uber.nullaway</groupId>
                                <artifactId>nullaway</artifactId>
                            </path>
                        </annotationProcessorPaths>
                        <compilerArgs>
                            <arg>--should-stop=ifError=FLOW</arg>
                            <arg>-XDcompilePolicy=simple</arg>
                            <arg>-Xplugin:ErrorProne \
                                -XepDisableAllChecks \
                                -Xep:NullAway:ERROR \
                                -Xep:RequireExplicitNullMarking:${explicit-null-marking-level} \
                                -XepDisableWarningsInGeneratedCode \
                                -XepExcludedPaths:${error-prone-excluded-paths} \
                                -XepOpt:NullAway:TreatGeneratedAsUnannotated=true \
                                -XepOpt:NullAway:GeneratedCodeAnnotations=com.google.protobuf.Generated \
                                -XepOpt:NullAway:JSpecifyMode=true \
                                -XepOpt:NullAway:OnlyNullMarked
                            </arg>

                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.api=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.file=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.main=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.model=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.parser=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.processing=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.tree=ALL-UNNAMED</arg>
                            <arg>-J--add-exports=jdk.compiler/com.sun.tools.javac.util=ALL-UNNAMED</arg>
                            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.code=ALL-UNNAMED</arg>
                            <arg>-J--add-opens=jdk.compiler/com.sun.tools.javac.comp=ALL-UNNAMED</arg>
                        </compilerArgs>
                    </configuration>
                    <!-- @formatter:on -->
                </plugin>

                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <executions>
                        <execution>
                            <goals>
                                <goal>
                                    build-info
                                </goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>com.google.cloud.tools</groupId>
                    <artifactId>jib-maven-plugin</artifactId>
                    <version>3.5.2</version>

                    <dependencies>
                        <dependency>
                            <groupId>com.google.cloud.tools</groupId>
                            <artifactId>jib-spring-boot-extension-maven</artifactId>
                            <version>0.1.0</version>
                        </dependency>
                    </dependencies>

                    <configuration>
                        <pluginExtensions>
                            <pluginExtension>
                                <implementation>
                                    com.google.cloud.tools.jib.maven.extension.springboot.JibSpringBootExtension
                                </implementation>
                            </pluginExtension>
                        </pluginExtensions>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>com.diffplug.spotless</groupId>
                    <artifactId>spotless-maven-plugin</artifactId>
                    <version>3.10.0</version>
                    <configuration>
                        <java>
                            <googleJavaFormat>
                                <style>AOSP</style>
                                <reorderImports>true</reorderImports>
                            </googleJavaFormat>
                        </java>
                        <kotlin>
                            <ktfmt>
                                <style>KOTLINLANG</style>
                            </ktfmt>
                            <includes>
                                <include>src/main/kotlin/**/*.kt</include>
                                <include>src/test/kotlin/**/*.kt</include>
                                <include>src/main/java/**/*.kt</include>
                                <include>src/test/java/**/*.kt</include>
                            </includes>
                        </kotlin>
                    </configuration>
                    <executions>
                        <!-- Automatically format during normal local Maven builds. -->
                        <execution>
                            <id>spotless-apply</id>
                            <phase>validate</phase>
                            <goals>
                                <goal>apply</goal>
                            </goals>
                        </execution>
                        <!-- Verify formatting as part of the normal Maven lifecycle. -->
                        <execution>
                            <id>spotless-check</id>
                            <phase>verify</phase>
                            <goals>
                                <goal>check</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-source-plugin</artifactId>
                    <executions>
                        <execution>
                            <id>attach-sources</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <doclint>none</doclint>
                        <quiet>true</quiet>
                    </configuration>
                    <executions>
                        <execution>
                            <id>attach-javadocs</id>
                            <goals>
                                <goal>jar</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>

                <plugin>
                    <groupId>org.jetbrains.kotlin</groupId>
                    <artifactId>kotlin-maven-plugin</artifactId>
                    <version>${kotlin.version}</version>

                    <configuration>
                        <args>
                            <arg>-Xjsr305=strict</arg>
                            <arg>-Xannotation-default-target=param-property</arg>
                        </args>
                        <compilerPlugins>
                            <plugin>spring</plugin>
                            <plugin>jpa</plugin>
                        </compilerPlugins>
                    </configuration>

                    <executions>
                        <execution>
                            <id>kapt</id>
                            <goals>
                                <goal>kapt</goal>
                            </goals>
                            <configuration>
                                <includeCompileClasspath>false</includeCompileClasspath>

                                <annotationProcessorPaths>
                                    <annotationProcessorPath>
                                        <groupId>org.springframework.boot</groupId>
                                        <artifactId>spring-boot-configuration-processor</artifactId>
                                        <version>${spring-boot.version}</version>
                                    </annotationProcessorPath>
                                </annotationProcessorPaths>
                            </configuration>
                        </execution>
                        <execution>
                            <id>compile</id>
                            <phase>compile</phase>
                            <goals>
                                <goal>compile</goal>
                            </goals>
                        </execution>

                        <execution>
                            <id>test-compile</id>
                            <phase>test-compile</phase>
                            <goals>
                                <goal>test-compile</goal>
                            </goals>
                        </execution>
                    </executions>

                    <dependencies>
                        <!-- Required by the spring compiler plugin -->
                        <dependency>
                            <groupId>org.jetbrains.kotlin</groupId>
                            <artifactId>kotlin-maven-allopen</artifactId>
                            <version>${kotlin.version}</version>
                        </dependency>

                        <!-- Required by the jpa compiler plugin -->
                        <dependency>
                            <groupId>org.jetbrains.kotlin</groupId>
                            <artifactId>kotlin-maven-noarg</artifactId>
                            <version>${kotlin.version}</version>
                        </dependency>
                    </dependencies>
                </plugin>

                <plugin>
                    <groupId>de.westemeyer</groupId>
                    <artifactId>artifact-version-maven-plugin</artifactId>
                    <version>2.1.0</version>
                    <executions>
                        <execution>
                            <goals>
                                <goal>generate-service</goal>
                            </goals>
                        </execution>
                    </executions>
                    <configuration>
                        <serviceType>NATIVE</serviceType>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>0.8.15</version>
                    <executions>
                        <execution>
                            <id>prepare-agent</id>
                            <phase>initialize</phase>
                            <goals>
                                <goal>prepare-agent</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

    <scm child.scm.url.inherit.append.path="false">
        <url>https://github.com/UbiqueInnovation/uetlib-spring-boot-starter-parent</url>
    </scm>
</project>
